<Window x:Class="BreakFree.Presentation.Views.RenameHabitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редагування звички"
        Height="260"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5"
        WindowStyle="SingleBorderWindow"
        Padding="10">

        <Grid Margin="10">

                <StackPanel>
                        <TextBlock Text="Редагування звички"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Нова назва:"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="NameTextBox"
                                 Height="32"
                                 FontSize="14"
                                 Background="White"
                                 BorderBrush="#CCC"
                                 Margin="0,0,0,10"/>

                        <CheckBox x:Name="IsActiveCheckBox"
                                  Content="Активна звичка"
                                  FontSize="14"
                                  Margin="0,0,0,20"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                                <Button Content="Зберегти"
                                        Width="120"
                                        Height="40"
                                        Background="#E57373"
                                        Foreground="White"
                                        Margin="0,0,15,0"
                                        BorderThickness="0"
                                        Click="Save_Click"/>

                                <Button Content="Скасувати"
                                        Width="120"
                                        Height="40"
                                        Background="#999"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Click="Cancel_Click"/>
                        </StackPanel>
                </StackPanel>

        </Grid>
</Window>
