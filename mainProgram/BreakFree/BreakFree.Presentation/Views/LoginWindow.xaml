<Window x:Class="BreakFree.Presentation.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BreakFree - Вхід"
        Height="450"
        Width="350"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style TargetType="Button"
                x:Key="PrimaryButton">
            <Setter Property="Background"
                    Value="#E57373"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="10,5"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
        </Style>

        <Style TargetType="Button"
                x:Key="SecondaryButton">
            <Setter Property="Background"
                    Value="#9E9E9E"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="10,5"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="280">

            <TextBlock Text="Увійдіть в профіль"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"
                       Foreground="#333"/>

            <!-- ЛОГІН -->
            <TextBlock Text="Логін (Email):"
                    FontSize="14"
                    Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsername"
                     Height="30"
                     Padding="5"
                     Margin="0,0,0,0"
                     TextChanged="TxtLogin_TextChanged"/>
            <TextBlock x:Name="LoginErrorText"
                       FontSize="11"
                       Height="15"
                       Margin="0,2,0,10"/>

            <!-- ПАРОЛЬ -->
            <TextBlock Text="Пароль:"
                    FontSize="14"
                    Margin="0,0,0,5"/>
            <!-- Важливо: PasswordChanged прив'язаний до методу в коді C# -->
            <PasswordBox x:Name="txtPassword"
                         Height="30"
                         Padding="5"
                         Margin="0,0,0,0"
                         PasswordChanged="TxtPassword_PasswordChanged"/>
            <!-- Текст помилки для пароля -->
            <TextBlock x:Name="PasswordErrorText"
                       FontSize="11"
                       Height="15"
                       Margin="0,2,0,10"/>

            <!-- КНОПКА ВХОДУ -->
            <!-- IsDefault="True" дозволяє натискати Enter для активації цієї кнопки -->
            <Button Content="Увійти"
                    Style="{StaticResource PrimaryButton}"
                    Height="40"
                    Margin="0,0,0,10"
                    IsDefault="True"
                    Click="Login_Click"/>

            <Button Content="Зареєструватися"
                    Style="{StaticResource SecondaryButton}"
                    Height="40"
                    Click="Register_Click"/>

        </StackPanel>
    </Grid>
</Window>