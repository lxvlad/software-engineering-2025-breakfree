<Window x:Class="BreakFree.Presentation.Views.AddHabitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BreakFree – Налаштування звички"
        Height="450"
        Width="530"
        Background="White"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="40,30,40,21">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="151*"/>
            <ColumnDefinition Width="27*"/>
            <ColumnDefinition Width="256*"/>
            <ColumnDefinition Width="16*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Налаштування звички"
                   FontSize="30"
                   FontWeight="Bold"
                   HorizontalAlignment="Left"
                   Margin="60,0,0,0"
                   Grid.ColumnSpan="3"/>

        <Grid Grid.ColumnSpan="4"
              VerticalAlignment="Top"
              Margin="10,90,10,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Назва звички:"
                       Grid.Row="0"
                       Grid.Column="0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,5,10"/>

            <TextBox Grid.Row="0"
                     Grid.Column="2"
                     Height="30"
                     BorderBrush="#ccc"
                     FontSize="16"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,10"
                     x:Name="txtHabitName"/>

            <TextBlock Text="Дата старту:"
                       Grid.Row="1"
                       Grid.Column="0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,5,10"/>

            <DatePicker Grid.Row="1"
                        Grid.Column="2"
                        Height="30"
                        BorderBrush="#ccc"
                        FontSize="16"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Margin="0,0,0,10"
                        x:Name="txtStartDate"/>

            <TextBlock Text="Щоденна ціль:"
                       Grid.Row="2"
                       Grid.Column="0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,5,2"/>

            <TextBox Grid.Row="2"
                     Grid.Column="2"
                     Height="30"
                     BorderBrush="#ccc"
                     FontSize="16"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,0"
                     x:Name="txtGoal"
                     TextChanged="TxtGoal_TextChanged"/>

            <TextBlock x:Name="GoalErrorText"
                       Grid.Row="3"
                       Grid.Column="2"
                       FontSize="11"
                       Margin="0,2,0,10"/>

            <TextBlock Text="Мотивація (опц.):"
                       Grid.Row="4"
                       Grid.Column="0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

            <TextBox Grid.Row="4"
                     Grid.Column="2"
                     Height="30"
                     BorderBrush="#ccc"
                     FontSize="16"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     x:Name="txtMotivation"/>
        </Grid>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="14,0,0,20"
                    Grid.ColumnSpan="4">

            <Button Content="Зберегти"
                    Width="150"
                    Height="40"
                    Background="#FF5C4D"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,110,0"
                    Click="SaveButton_Click"/>

            <Button Content="Скасувати"
                    Width="150"
                    Height="40"
                    Background="#999"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
