<Window x:Class="BreakFree.Presentation.Views.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BreakFree – Прогрес за місяць"
        Height="650"
        Width="630"
        Background="White"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

        <Grid Margin="40">

                <!-- Головний заголовок -->
                <TextBlock Text="Прогрес за місяць"
                           FontSize="30"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- Назва місяця -->
                <TextBlock x:Name="MonthTitle"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,40,0,0"
                           VerticalAlignment="Top"/>

                <!-- Календар -->
                <Grid x:Name="CalendarGrid"
                      Margin="0,100,0,80"
                      HorizontalAlignment="Center"
                      Width="500"
                      Height="220">

                        <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                </Grid>

                <!-- Стрілочки під календариком -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,90">

                        <!-- Назад -->
                        <StackPanel HorizontalAlignment="Center"
                                    Margin="0,0,40,0">
                                <Button Content="⟨"
                                        Width="45"
                                        Height="45"
                                        FontSize="24"
                                        Background="Transparent"
                                        BorderBrush="#999"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Click="PrevMonth_Click"/>

                                <TextBlock Text="Назад"
                                           FontSize="13"
                                           Foreground="#555"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="PrevMonthLabel_Click"/>
                        </StackPanel>

                        <!-- Вперед -->
                        <StackPanel HorizontalAlignment="Center"
                                    Margin="40,0,0,0">
                                <Button Content="⟩"
                                        Width="45"
                                        Height="45"
                                        FontSize="24"
                                        Background="Transparent"
                                        BorderBrush="#999"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Click="NextMonth_Click"/>

                                <TextBlock Text="Вперед"
                                           FontSize="13"
                                           Foreground="#555"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="NextMonthLabel_Click"/>
                        </StackPanel>

                </StackPanel>

                <!-- Кнопки внизу -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,20">
                        <Button Content="Відкрити журнал"
                                Width="150"
                                Height="40"
                                Background="#999"
                                Foreground="White"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Margin="0,0,40,0"
                                Click="Button_Click_1"/>

                        <Button Content="Закрити"
                                Width="120"
                                Height="40"
                                Background="#999"
                                Foreground="White"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Click="CloseButton_Click"/>
                </StackPanel>

        </Grid>
</Window>
