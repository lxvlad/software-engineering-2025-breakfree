<Window x:Class="BreakFree.Presentation.Views.EditDailyGoalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Щоденна ціль"
        Height="220"
        Width="350"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Стиль для основної кнопки (Зберегти) -->
        <Style TargetType="Button"
                x:Key="PrimaryButton">
            <Setter Property="Background"
                    Value="#E57373"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="10,5"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для другорядної кнопки (Скасувати) -->
        <Style TargetType="Button"
                x:Key="SecondaryButton">
            <Setter Property="Background"
                    Value="#9E9E9E"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="10,5"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="280">

            <TextBlock Text="Нова сума за день (грн)"
                       FontSize="18"
                    FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                    Margin="0,0,0,15"
                    Foreground="#333"/>

            <TextBox x:Name="GoalTextBox"
                     Height="40"
                     VerticalContentAlignment="Center"
                     BorderBrush="#ccc"
                     Padding="8"
                    FontSize="14"
                     Margin="0,0,0,25">
                <TextBox.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius"
                                Value="5"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
                <Button Content="Зберегти"
                        Click="Save_Click"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Height="40"
                        Width="110"
                        Margin="0,0,15,0"/>

                <Button Content="Скасувати"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}"
                        Height="40"
                        Width="110"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>