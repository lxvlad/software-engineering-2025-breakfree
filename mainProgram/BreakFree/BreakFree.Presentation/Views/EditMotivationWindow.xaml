<Window x:Class="BreakFree.Presentation.Views.EditMotivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мотивація"
        Height="200"
        Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Стиль для основної кнопки (Зберегти) -->
        <Style TargetType="Button"
                x:Key="PrimaryButton"
                BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"
                    Value="#E57373"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="10,5"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для другорядної кнопки (Скасувати) -->
        <Style TargetType="Button"
                x:Key="SecondaryButton"
                BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"
                    Value="#9E9E9E"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="10,5"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="340">

            <TextBlock Text="Введіть нову мотивацію"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"
                       Foreground="#333"/>

            <TextBox x:Name="MotivationTextBox"
                     Height="37"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     BorderBrush="#ccc"
                     Padding="8"
                     FontSize="14"
                     Margin="0,0,0,25"
                     VerticalScrollBarVisibility="Auto">
                <TextBox.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius"
                                Value="5"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- Кнопки розміщені по центру (HorizontalAlignment="Center") -->
            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
                <Button Content="Зберегти"
                        Click="Save_Click"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Height="40"
                        Width="120"
                        Margin="0,0,15,0"/>

                <Button Content="Скасувати"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}"
                        Height="40"
                        Width="120"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>