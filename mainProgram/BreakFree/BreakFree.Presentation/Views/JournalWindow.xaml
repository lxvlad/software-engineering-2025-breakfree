<Window x:Class="BreakFree.Presentation.Views.JournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BreakFree – Журнал зривів"
        Height="550"
        Width="500"
        Background="White"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

  <Grid Margin="20">
    <Grid.ContextMenu>
      <ContextMenu>
        <MenuItem Header="✏️ Редагувати" Click="EditEntry_Click"/>
        <MenuItem Header="🗑 Видалити" Click="DeleteEntry_Click"/>
      </ContextMenu>
    </Grid.ContextMenu>

    <TextBlock Text="Журнал зривів"
               FontSize="30"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,0,0,25"/>


    <DataGrid x:Name="JournalDataGrid"
                Margin="0,70,0,100"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                IsReadOnly="True"
                SelectionMode="Single">


      <DataGrid.Columns>
        <DataGridTextColumn Header="Дата"
                            Binding="{Binding Date}"
                            Width="100"/>

        <DataGridTextColumn Header="Причина"
                            Binding="{Binding Reason}"
                            Width="150"/>

        <DataGridTextColumn Header="Коротка нотатка"
                            Binding="{Binding Note}"
                            Width="*"/>
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,30">
      <Button Content="Додати зрив"
              Width="150"
              Height="40"
              Background="#E57373"
              Foreground="White"
              FontSize="15"
              FontWeight="SemiBold"
              Margin="0,0,40,0"
              Click="AddRelapse_Click">
        <Button.Resources>
          <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
          </Style>
        </Button.Resources>
      </Button>

      <Button Content="Закрити"
              Width="150"
              Height="40"
              Background="#999"
              Foreground="White"
              FontSize="15"
              FontWeight="SemiBold"
              Click="CloseButton_Click">
        <Button.Resources>
          <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
          </Style>
        </Button.Resources>
      </Button>
    </StackPanel>
  </Grid>
</Window>