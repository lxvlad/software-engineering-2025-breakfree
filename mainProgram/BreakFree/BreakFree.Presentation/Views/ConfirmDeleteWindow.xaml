<Window x:Class="BreakFree.Presentation.Views.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Видалення" Height="200" Width="350"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <Style TargetType="Button" x:Key="BtnStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Видалити цей запис?" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="#333"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Так, видалити" Height="40" Margin="0,0,10,0" Width="130"
                        Background="#FF5C4D" Foreground="White" Style="{StaticResource BtnStyle}"
                        Click="Yes_Click"/>
                <Button Content="Скасувати" Height="40" Width="130"
                        Background="#999" Foreground="White" Style="{StaticResource BtnStyle}"
                        Click="No_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>