<Window x:Class="BreakFree.Presentation.Views.ProfileWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BreakFree – Керування профілем"
        Height="500"
        Width="450"
        Background="White"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="40">

        <TextBlock Text="Керування профілем"
                   FontSize="30"
                   FontWeight="Bold"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,40"/>

        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Ім'я:"
                       Grid.Row="0"
                       Grid.Column="0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,15"/>
            <TextBox x:Name="txtUsername"
                     Grid.Row="0"
                     Grid.Column="1"
                     Height="30"
                     BorderBrush="#ccc"
                     FontSize="14"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Email:"
                       Grid.Row="1"
                       Grid.Column="0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,15"/>
            <TextBox x:Name="txtEmail"
                     Grid.Row="1"
                     Grid.Column="1"
                     Height="30"
                     BorderBrush="#ccc"
                     FontSize="14"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Дата старту:"
                       Grid.Row="2"
                       Grid.Column="0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,15"/>
            <TextBlock x:Name="StartDateText"
                       Text="Завантаження..."
                       Grid.Row="2"
                       Grid.Column="1"
                       FontSize="15"
                       VerticalAlignment="Center"
                       Margin="0,0,0,15"/>

            <TextBlock Text="Безпека"
                       Grid.Row="3"
                       Grid.ColumnSpan="2"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,30,0,20"/>
        </Grid>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,220,0,0">

            <Button Content="Змінити пароль"
                    Width="155"
                    Height="40"
                    Background="#999"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Margin="0,0,30,0"
                    Click="ChangePasswordButton_Click"/>

            <Button Content="Видалити профіль"
                    Width="155"
                    Height="40"
                    Background="#999"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Click="DeleteProfileButton_Click"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,10">

            <Button Content="Зберегти зміни"
                    Width="155"
                    Height="40"
                    Background="#FF5C4D"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,30,0"
                    Click="SaveChangesButton_Click"/>

            <Button Content="Скасувати"
                    Width="155"
                    Height="40"
                    Background="#999"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Click="CancelButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
