<Window x:Class="BreakFree.Presentation.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BreakFree - Реєстрація"
        Height="500"
        Width="380"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style TargetType="Button"
                x:Key="PrimaryButton">
            <Setter Property="Background"
                    Value="#E57373"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="10,5"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
        </Style>

        <Style TargetType="Button"
                x:Key="SecondaryButton">
            <Setter Property="Background"
                    Value="#9E9E9E"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="10,5"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="300">

            <TextBlock Text="Створіть профіль"
                    FontSize="22"
                    FontWeight="Bold"
                       HorizontalAlignment="Center"
                    Margin="0,0,0,10"
                    Foreground="#333"/>

            <!-- Ім'я -->
            <TextBlock Text="Ім’я:"
                    FontSize="14"
                    Margin="0,0,0,2"/>
            <TextBox x:Name="NameTextBox"
                    Height="30"
                    Padding="5"
                    Margin="0,0,0,0"
                     TextChanged="NameTextBox_TextChanged"/>
            <TextBlock x:Name="NameErrorText"
                    FontSize="11"
                    Height="15"
                    Margin="0,0,0,2"/>

            <!-- Email -->
            <TextBlock Text="Email:"
                    FontSize="14"
                    Margin="0,0,0,2"/>
            <TextBox x:Name="EmailTextBox"
                    Height="30"
                    Padding="5"
                    Margin="0,0,0,0"
                     TextChanged="EmailTextBox_TextChanged"/>
            <TextBlock x:Name="EmailErrorText"
                    FontSize="11"
                    Height="15"
                    Margin="0,0,0,2"/>

            <!-- Пароль -->
            <TextBlock Text="Пароль:"
                    FontSize="14"
                    Margin="0,0,0,2"/>
            <PasswordBox x:Name="PasswordBox"
                    Height="30"
                    Padding="5"
                    Margin="0,0,0,0"
                         PasswordChanged="PasswordBox_PasswordChanged"/>
            <!-- Змінено Height="30" на MinHeight="15", щоб займав менше місця, коли помилки немає або вона коротка -->
            <TextBlock x:Name="PasswordErrorText"
                    FontSize="11"
                    MinHeight="15"
                    TextWrapping="Wrap"
                    Margin="0,0,0,2"/>

            <!-- Підтвердження -->
            <TextBlock Text="Підтвердження паролю:"
                    FontSize="14"
                    Margin="0,0,0,2"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                    Height="30"
                    Padding="5"
                    Margin="0,0,0,0"
                         PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
            <TextBlock x:Name="ConfirmErrorText"
                    FontSize="11"
                    Height="15"
                    Margin="0,0,0,10"/>

            <!-- Кнопки -->
            <Button Content="Зареєструватися"
                    Style="{StaticResource PrimaryButton}"
                    Height="40"
                    Margin="0,0,0,10"
                    Click="RegisterButton_Click"/>

            <Button Content="Скасувати"
                    Style="{StaticResource SecondaryButton}"
                    Height="40"
                    Click="CancelButton_Click"/>

        </StackPanel>
    </Grid>
</Window>